<Instance ref.CodeBehind="false"
          ref.Class="demo::TestWindow">
  <Window ref.Name="self" Text="Hello, world!"
          ClientSize="x:320 y:0" SizeBox="false"
          MinimizedBox="false" MaximizedBox="false">
    <ez:Layout Padding="5" Border="false">
      <ez:Fill>
        <Label Text="Welcome to Gaclib."/>
      </ez:Fill>
      <ez:Bottom>
        <ez:Right>
          <Button Text="OK" ev.Clicked-eval="{ self.Close(); }">
            <att.BoundsComposition-set PreferredMinSize="x:72"/>
          </Button>
        </ez:Right>
      </ez:Bottom>
    </ez:Layout>
  </Window>
</Instance>
