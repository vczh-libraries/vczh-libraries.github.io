<Instance ref.CodeBehind="false"
          ref.Class="demo::TestWindow">
  <ref.Parameter Name="ViewModel" Class="IHelloViewModel"/>
  <Window Text="Say hello"
          ClientSize="x:360 y:0" SizeBox="false"
          MinimizedBox="false" MaximizedBox="false">
    <att.ViewModel-set Name-bind="nameInput.Text"/>
    <ez:Layout Padding="5" Border="false">
      <ez:Top>
        <Label Text="Your name"/>
      </ez:Top>
      <ez:Top>
        <SinglelineTextBox ref.Name="nameInput" Text="world"/>
      </ez:Top>
      <ez:Top>
        <Label Text-bind="ViewModel.Welcome"/>
      </ez:Top>
    </ez:Layout>
  </Window>
</Instance>
